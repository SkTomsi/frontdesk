{
  "name": "frontdesk",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun --hot ./apps/api/src/index.ts",
    "dev:app": "bun --cwd apps/frontend dev",
    "dev": "bun run dev:api & bun run dev:app",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:push": "bun --cwd packages/db db:push",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:drop": "bun --cwd packages/db db:drop",
    "db:check": "bun --cwd packages/db db:check",
    "db:up": "bun --cwd packages/db db:up"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
