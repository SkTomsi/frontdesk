{
  "name": "frontdesk",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun --hot ./apps/api/src/index.ts",
    "dev:app": "bun --cwd apps/frontend dev",
    "dev": "bun run dev:api & bun run dev:app",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:push": "bun drizzle-kit push",
    "db:studio": "bun drizzle-kit studio",
    "db:drop": "bun drizzle-kit drop",
    "db:check": "bun drizzle-kit check",
    "db:up": "bun drizzle-kit up"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^5"
  }
}
