{
  "name": "@frontdesk/db",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./repositories": "./src/repositories/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:drop": "bun --bun drizzle-kit drop",
    "db:check": "bun --bun drizzle-kit check",
    "db:up": "bun --bun drizzle-kit up"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
